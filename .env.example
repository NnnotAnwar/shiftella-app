# --- Supabase (client) ---
# Project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Publishable (anon) key from Supabase → Project Settings → API.
# This is a public client key — never put the service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Public web URL (optional) ---
# Used only by the native (Capacitor) app as the host for links in signup
# confirmation emails; the web app uses its own origin. Set it before building the
# native app, e.g. https://shiftella.app. Unset = legacy https://planuj-smeny.vercel.app.
VITE_PUBLIC_SITE_URL=
