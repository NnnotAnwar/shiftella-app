# Shiftella web host: /etc/caddy/Caddyfile
#
# Serves the static Vite build (no server-side code) for
#   shiftella.app       <- /srv/shiftella/prod/current   (prod Supabase)
#   dev.shiftella.app   <- /srv/shiftella/dev/current    (preprod Supabase)
# `current` is a symlink switched atomically by shiftella-release; Caddy follows it
# on every request, so deploys and rollbacks need no Caddy reload.
#
# HTTPS certificates are issued and renewed automatically (Let's Encrypt / ZeroSSL)
# once the DNS records point at this server. Install / change:
#   sudo install -m 644 Caddyfile /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy

{
	# Optional: mailbox for certificate-problem notices from the CA.
	# email ops@shiftella.app
}

# ---------------------------------------------------------------------------
# Shared site definition.
#   args[0]  site dir name under /srv/shiftella        (prod | dev)
#   args[1]  Supabase project ref this build talks to (CSP connect-src)
#   args[2]  CSP header name: Content-Security-Policy, or
#            Content-Security-Policy-Report-Only while a CSP is being trialled
# ---------------------------------------------------------------------------
(shiftella_spa) {
	root * /srv/shiftella/{args[0]}/current
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=(), serial=(), bluetooth=(), browsing-topics=()"
		-Server
	}

	# What the app actually loads (checked in index.html + src/ at the time of writing):
	#   - own origin: JS/CSS chunks, icons, manifest
	#   - Supabase: REST/Auth/Functions over https, Realtime over wss
	#   - Google Fonts (Inter): CSS from fonts.googleapis.com, files from fonts.gstatic.com
	#   - Fontshare (Satoshi): CSS from api.fontshare.com, files from cdn.fontshare.com
	#   - blob:/data: for PDF/XLSX exports and the embedded PDF font
	# 'unsafe-inline' in style-src is for libraries that set inline styles
	# (framer-motion etc.); scripts stay strictly 'self'.
	# Adding a third-party service (e.g. Stripe.js for billing) means adding its
	# origins here first: see README "CSP".
	header {args[2]} "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.fontshare.com https://api.fontshare.com; img-src 'self' data: blob:; connect-src 'self' https://{args[1]}.supabase.co wss://{args[1]}.supabase.co; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

	# Hashed build output (/assets/<name>-<hash>.js|css): cache forever.
	# A missing asset is a real 404, never index.html (avoids "text/html is not a
	# valid JavaScript MIME type" errors after a deploy).
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Un-hashed static files from public/: cache briefly.
	@static path /icons/* /favicon.svg /vite.svg
	handle @static {
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# PWA manifest: always revalidate.
	handle /manifest.webmanifest {
		header Cache-Control "no-cache"
		header Content-Type "application/manifest+json"
		file_server
	}

	# Everything else is a client-side route: SPA fallback to index.html,
	# which must always be revalidated so a deploy is picked up immediately.
	# (The app has no service worker; if one is added, give sw.js this treatment too.)
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/shiftella-{args[0]}.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 336h
		}
	}
}

# --- Production -------------------------------------------------------------
www.shiftella.app {
	redir https://shiftella.app{uri} permanent
}

shiftella.app {
	# Prod Supabase project: dcqvipzjqxpbaymaxhxu.
	# CSP starts in Report-Only so a missed origin cannot break prod. After the
	# same policy has been enforced on dev.shiftella.app and PDF/XLSX export,
	# login, realtime and invites were clicked through there without CSP errors
	# in the browser console, change the last argument to Content-Security-Policy.
	import shiftella_spa prod dcqvipzjqxpbaymaxhxu Content-Security-Policy-Report-Only
}

# --- Preprod ----------------------------------------------------------------
dev.shiftella.app {
	# Preprod Supabase project: fusnqxykhdzcvhqbsevb. CSP enforced here first.
	import shiftella_spa dev fusnqxykhdzcvhqbsevb Content-Security-Policy
	header X-Robots-Tag "noindex, nofollow"
}

