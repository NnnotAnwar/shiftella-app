#!/usr/bin/env bash
# shiftella-release: atomic release switching on the Hetzner web host.
#
# Lives in the repo (deploy/hetzner/bin/) and is uploaded to
# /srv/shiftella/bin/ by .github/workflows/deploy-hetzner.yml on every deploy,
# so the server always runs the version that matches the repo.
#
# Layout (created by cloud-init.yaml):
#   /srv/shiftella/<site>/releases/<sha>/   one directory per deployed build
#   /srv/shiftella/<site>/current  -> releases/<sha>   (what Caddy serves)
#   /srv/shiftella/<site>/previous -> releases/<sha>   (instant rollback target)
#   /srv/shiftella/<site>/history                      (activation log)
# <site> is "prod" (shiftella.app) or "dev" (dev.shiftella.app).
#
# Usage (as the deploy user):
#   shiftella-release activate <site> <upload-dir> <sha>
#       Turn an uploaded build (releases/.upload-*) into a release and make it live.
#   shiftella-release rollback <site> [<sha-or-prefix>]
#       Make <sha> live again, or with no argument the previously live release.
#       Running it twice without an argument toggles back.
#   shiftella-release list <site>
#       Show the releases on disk, newest first.
set -euo pipefail

ROOT=/srv/shiftella
KEEP=5          # releases kept on disk (current and previous are never pruned)
CARRY_DAYS=14   # hashed assets younger than this are carried into the next release

die() { echo "shiftella-release: $*" >&2; exit 1; }

cmd=${1:-}
site=${2:-}
case "$site" in prod|dev) ;; *) die "site must be 'prod' or 'dev' (got '${site}')" ;; esac
base="$ROOT/$site"
releases="$base/releases"
[ -d "$releases" ] || die "$releases does not exist (was cloud-init run?)"

link_target() { [ -L "$base/$1" ] && basename "$(readlink "$base/$1")" || true; }

# Atomically repoint a symlink: build it under a temp name, then rename(2) over the old one.
relink() { # <link-name> <release-name>
  ln -sfn "releases/$2" "$base/.$1.tmp"
  mv -Tf "$base/.$1.tmp" "$base/$1"
}

switch_to() { # <release-name>
  local name=$1 old
  [ -f "$releases/$name/index.html" ] || die "release '$name' has no index.html"
  old=$(link_target current)
  if [ "$old" = "$name" ]; then
    echo "$name is already live on $site"
    return
  fi
  relink current "$name"
  [ -n "$old" ] && [ -d "$releases/$old" ] && relink previous "$old"
  touch "$releases/$name"   # mtime = last time it went live; used for pruning
  echo "$(date -u +%FT%TZ) $name" >> "$base/history"
  echo "live on $site: $name (previous: ${old:-none})"
}

prune() {
  local cur prev
  cur=$(link_target current)
  prev=$(link_target previous)
  # Uploads from failed / cancelled runs.
  find "$releases" -mindepth 1 -maxdepth 1 -name '.upload-*' -mmin +60 -exec rm -rf {} +
  # Everything beyond the newest $KEEP releases, except what current/previous point to.
  # (Release names are hex shas, optionally with a -timestamp suffix: no spaces.)
  ls -1t "$releases" | tail -n +$((KEEP + 1)) | while read -r d; do
    [ "$d" = "$cur" ] || [ "$d" = "$prev" ] || rm -rf "${releases:?}/$d"
  done
}

case "$cmd" in
  activate)
    upload=${3:-}
    sha=${4:-}
    [[ "$upload" =~ ^\.upload-[A-Za-z0-9._-]+$ ]] || die "bad upload dir name '$upload'"
    [[ "$sha" =~ ^[0-9a-f]{7,40}$ ]] || die "bad sha '$sha'"
    [ -f "$releases/$upload/index.html" ] || die "$releases/$upload/index.html missing (upload failed?)"

    name=$sha
    # Same commit deployed again (e.g. after changing an env variable): keep both.
    [ -e "$releases/$name" ] && name="$sha-$(date -u +%Y%m%d%H%M%S)"

    # Browser tabs that loaded the old index.html lazy-load route chunks by their
    # old hashed names. Hard-link the live release's recent assets into the new
    # one so those requests keep working after the switch (no extra disk space).
    if [ -d "$base/current/assets/" ] && [ -d "$releases/$upload/assets" ]; then
      find "$base/current/assets/" -maxdepth 1 -type f -mtime "-$CARRY_DAYS" \
        -exec cp -l --update=none -t "$releases/$upload/assets/" {} +
    fi

    mv -T "$releases/$upload" "$releases/$name"
    switch_to "$name"
    prune
    ;;

  rollback)
    want=${3:-}
    if [ -z "$want" ]; then
      target=$(link_target previous)
      [ -n "$target" ] || die "no previous release recorded for $site; pass a sha (see: shiftella-release list $site)"
    else
      [[ "$want" =~ ^[0-9a-f]{4,40}(-[0-9]{14})?$ ]] || die "bad sha '$want'"
      # Newest release whose name starts with the given sha / prefix.
      target=$(ls -1t "$releases" | grep -m1 "^$want" || true)
      [ -n "$target" ] || die "no release matching '$want' on $site (see: shiftella-release list $site)"
    fi
    switch_to "$target"
    ;;

  list)
    cur=$(link_target current)
    prev=$(link_target previous)
    ls -1t "$releases" | while read -r d; do
      mark=""
      [ "$d" = "$cur" ] && mark="  <- current"
      [ "$d" = "$prev" ] && mark="  <- previous"
      printf '%s  %s%s\n' "$(date -u -r "$releases/$d" +%FT%TZ)" "$d" "$mark"
    done
    ;;

  *)
    die "usage: shiftella-release {activate <site> <upload-dir> <sha> | rollback <site> [sha] | list <site>}"
    ;;
esac
