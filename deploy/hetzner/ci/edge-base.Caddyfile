# CI-ONLY stand-in for the anwar.os edge base Caddyfile
# (NnnotAnwar/anwar-os → infra/edge, mounted on the server at
# /etc/caddy/base/Caddyfile). It mirrors the contract shiftella.caddy relies on:
# global email + the `security_headers` snippet + importing the site files.
# If the real file changes its snippet name or import path, update this copy.
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}
	# Deletions in their own block: a block with deletions is deferred and
	# would otherwise skip Caddy's own error responses (basic_auth 401, 404).
	header {
		-Server
		-X-Powered-By
	}
}

import /etc/caddy/sites/*.caddy
